# Copy this file to .env and fill in the values you need. Never commit the real .env --
# secrets belong in the environment, not in the repository.
#
# Everything below has a working default for a local trial except the three marked REQUIRED.
# See docs/configuration.md for the exhaustive, source-generated list of every variable the
# backend reads, and docs/getting-started.md for how these fit into the first run.

# ── Required ──────────────────────────────────────────────────────────────────
# Postgres: the control plane's own database, and Stalwart's storage backend.
POSTGRES_USER=beskos
POSTGRES_PASSWORD=change-me-postgres   # REQUIRED
POSTGRES_DB=beskos

# Stalwart's global recovery admin. Only the Go backend ever uses it; it never reaches the
# frontend. Pick a real secret even for local testing -- Stalwart refuses a weak one.
STALWART_ADMIN_SECRET=change-me-stalwart-admin   # REQUIRED

# Object storage (MinIO) for the Files app and encrypted attachments.
MINIO_ROOT_USER=beskos
MINIO_ROOT_PASSWORD=change-me-minio   # REQUIRED

# ── Stalwart bootstrap ────────────────────────────────────────────────────────
# Hostname and default domain used the first time Stalwart is provisioned. Match these to your
# real mail domain before going to production; the local trial defaults work as-is.
STALWART_HOSTNAME=mail.localhost
STALWART_DEFAULT_DOMAIN=localhost

# Local trial only: test domains don't resolve in DNS, so skip verification to provision anyway.
# Never set this in production -- it disables the check that a domain's DNS is actually published.
PROVISION_SKIP_DNS_VERIFY=true

# ── AI assistant (optional) ───────────────────────────────────────────────────
# Any endpoint that speaks the OpenAI-compatible chat API, which is nearly all of them: OpenAI and
# Azure, Mistral, Groq, Together, OpenRouter, DeepSeek, TensorX, and local runtimes such as Ollama,
# vLLM, llama.cpp or LM Studio. Leave AI_API_KEY empty and the assistant, along with OnlyOffice's
# AI panel, is simply off.
#
# AI_PROVIDER is a label for logs and metrics. Four names are also presets that fill in the
# address: deepseek, tensorx, openai, ollama. Any other name works too -- give it AI_BASE_URL.
# AI_MODEL is required unless the preset carries one; there is deliberately no global default,
# because a model name is the part that goes stale (the previous default, deepseek-chat, was
# discontinued by its vendor).
#
#   AI_PROVIDER=openai   AI_MODEL=gpt-4o-mini
#   AI_PROVIDER=ollama   AI_MODEL=llama3.1          # nothing leaves the machine
#   AI_PROVIDER=groq     AI_MODEL=llama-3.3-70b-versatile  AI_BASE_URL=https://api.groq.com/openai/v1
AI_PROVIDER=deepseek
AI_API_KEY=
AI_BASE_URL=
AI_MODEL=
# "on" lets the model think before answering, where the endpoint supports it. Slower, and in
# streaming the reasoning arrives before any text, so the reply looks stalled.
AI_REASONING=

# ── Meeting recording / office editing / wiki search (optional) ──────────────
# Video calls (LiveKit) and the webmail work without any of these. Each one below turns on a
# single optional feature; leaving its key empty turns that feature off, nothing else changes.

# OnlyOffice Document Server: in-browser editing of Word/Excel/PowerPoint documents.
ONLYOFFICE_URL=http://localhost:8082
ONLYOFFICE_JWT_SECRET=change-me-onlyoffice-jwt
DOC_TOKEN_SECRET=change-me-doc-token-secret
# AGPL v3 §13: we run a modified OnlyOffice image (deploy/onlyoffice/), so the license requires
# telling users where that modified source is. Point this at YOUR OWN fork if you changed the
# branding patch; the default deployment doesn't touch it, but ONLYOFFICE_SOURCE_URL is still
# required once APP_ENV=production and ONLYOFFICE_URL is set -- the backend refuses to boot
# without it (see backend/internal/config/config.go).
ONLYOFFICE_SOURCE_URL=

# Meet (LiveKit): self-hosted video calls. The API key/secret sign room tokens and must match
# deploy/livekit/livekit.yaml.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-livekit-secret

# Wiki semantic search: any OpenAI-compatible /embeddings endpoint. Unset -- the wiki still works,
# just without AI-powered search over its content.
#
# All three are required together. The address and the model have no defaults on purpose: they used
# to fall back to one vendor's endpoint, so an installation that set only the key sent that key --
# and the text of every wiki page -- to a company it had never chosen.
#
# EMBEDDINGS_DIMENSIONS must match the vector(N) column in the database; longer vectors are
# truncated, which the common models are trained to tolerate. Changing it means re-indexing.
EMBEDDINGS_API_KEY=
EMBEDDINGS_BASE_URL=https://api.openai.com/v1
EMBEDDINGS_MODEL=text-embedding-3-small
EMBEDDINGS_DIMENSIONS=1536

# ── SMS for MFA (optional) ────────────────────────────────────────────────────
# "log" (default) prints the code to the container's logs -- fine for testing, useless for real
# users. "sns" sends over Amazon SNS, using the AWS credentials below (also used, separately, by
# the optional SES-based automatic DKIM signup path -- most self-hosters don't need either).
SMS_PROVIDER=log
SMS_SENDER_ID=
SNS_REGION=
SES_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Billing (optional) ────────────────────────────────────────────────────────
# "manual" (default): a plan is applied immediately, no payment processor involved -- the normal
# choice for a self-hosted instance running for one organization.
BILLING_PROVIDER=manual

# ── Outbound notification e-mail (optional) ───────────────────────────────────
# Account and security notifications (password reset, new device, etc). Unset NOTIFY_SMTP_HOST --
# these notifications are simply not sent. If you route through Stalwart itself, use port 465
# with implicit TLS; its port 587 listener closes the connection immediately.
NOTIFY_SMTP_HOST=
NOTIFY_SMTP_PORT=465
NOTIFY_SMTP_USER=
NOTIFY_SMTP_PASSWORD=
NOTIFY_FROM=
NOTIFY_SMTP_INSECURE=false

# ── Web Push (optional) ───────────────────────────────────────────────────────
# Desktop notifications while Beskos is closed. Generate a VAPID key pair once and keep it
# stable; SUBJECT is a contact mailto: the protocol requires.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@localhost

# ── Branding ───────────────────────────────────────────────────────────────────
# Shown wherever the product faces someone outside it (OnlyOffice's "about" panel, links when
# PUBLIC_URL is empty). Override these with your own if you rebrand a self-hosted instance.
BRAND_NAME=Beskos
BRAND_URL=
SALES_EMAIL=

# ── Networking / limits ───────────────────────────────────────────────────────
# Comma-separated CORS origins the native desktop/mobile app (Tauri) is allowed to call from.
APP_ORIGINS=
# The app's public URL (e.g. https://app.example.org), used to build absolute links that leave
# the app -- a meeting link inside an e-mail, for instance. Empty -- links are relative, which is
# fine in development and useless in an e-mail.
PUBLIC_URL=
FILES_MAX_UPLOAD_BYTES=107374182400

# A Pro license key, if you have one -- see docs/editions.md. Unset means Community.
EDITION_LICENSE_KEY=
EDITION_PUBLIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# Security / production
# ─────────────────────────────────────────────────────────────────────────────

# "development" (default) runs with permissive defaults. In "production" the backend fails
# closed at boot: it refuses to start with an empty secret, a secret shorter than 16 characters,
# or a known development default, and requires COOKIE_SECURE=true and NOTIFY_SMTP_INSECURE=false.
APP_ENV=development

# Encrypts the TOTP secret (MFA) at rest with AES-256-GCM. Without this key the secret is stored
# in the clear -- acceptable only in development. In production, set a strong, STABLE key
# (rotating it invalidates every TOTP already enrolled). Generate with: openssl rand -base64 48
MFA_ENC_KEY=

# Session cookie as SameSite=None; Secure -- required in production over HTTPS (and for the
# cross-site native app). Leave false in development (plain HTTP); the backend refuses to boot
# in production without it.
COOKIE_SECURE=false
