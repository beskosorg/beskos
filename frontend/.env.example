# Frontend environment variables. They are EMBEDDED IN PLAIN TEXT in the bundle (web/desktop/mobile),
# so they MUST NOT be secrets — they're just public server URLs.
#
# - Web/dev: leave EMPTY. Calls stay relative and the proxy (Vite/Caddy) handles /api and /jmap.
# - Packaged Tauri app: set the server's public URL (there is no proxy in the bundle).
#     VITE_API_BASE=https://app.yourcompany.com
#
# NEVER put keys/secrets here or in any VITE_ variable — the build fails on purpose
# (see vite.config.ts). Secrets (AI, Stalwart admin, database, private VAPID) live only in the
# Go backend and are never sent to the frontend.
VITE_API_BASE=

# PUBLIC origin of the web app, used in SHAREABLE links generated by the native app (meeting
# invite /j/<room>, links in emails, shares). On desktop the local origin is tauri://localhost —
# useless to third parties. Without this var, it falls back to VITE_API_BASE (in production Caddy
# serves the SPA and the API on the same origin, so that's usually enough).
#     VITE_PUBLIC_BASE=https://app.yourcompany.com
VITE_PUBLIC_BASE=

# ---------------------------------------------------------------------------
# WORKING ON THE FRONTEND AGAINST THE PRODUCTION API
#
#     API_URL=https://app.beskos.com npm run dev
#
# Not a VITE_ variable (it doesn't go into the bundle): it's read by vite.config.ts and only
# configures the dev server's proxy. Calls stay relative, so the browser sees everything on the
# same origin and the session cookie works.
#
# IT MUST BE localhost, not a local network IP: the production cookie is Secure, and browsers
# only accept Secure cookies over http on `localhost`. On an IP they'd be silently rejected, and
# the session would seem to get lost with no explanation.
#
# WARNING: this is REAL DATA. Deleting a message, removing a user, or sending an email from here
# really happens, on the real account. To experiment without risk, spin up the local backend
# (docker compose in deploy/) and leave API_URL unset.
# ---------------------------------------------------------------------------
