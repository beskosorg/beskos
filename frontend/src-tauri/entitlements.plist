<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- macOS app entitlements. Camera/microphone for Meet video calls (WKWebView). Applied at signing
     (ad-hoc by default); required once the app is signed/notarized with the hardened runtime. The
     usage descriptions live in Info.plist. -->
<plist version="1.0">
<dict>
  <key>com.apple.security.device.camera</key>
  <true/>
  <key>com.apple.security.device.audio-input</key>
  <true/>
</dict>
</plist>
